DATABASE_URL=postgres://localhost:5432/linenet_crm
BETTER_AUTH_SECRET=change-me-32-bytes-hex
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Microsoft sign-in to the CRM (separate from mailbox connection).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Outlook.com / Hotmail or work mailbox connection with delegated Mail.Read.
# App registration: personal accounts, or organizational AND personal accounts.
# Web redirect: http://localhost:3000/api/mail/outlook/callback (use HTTPS online).
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# Generate once: openssl rand -hex 32. Keep the same key across restarts/deployments.
MAIL_TOKEN_ENCRYPTION_KEY=

# Mailbox polling via Microsoft Graph (application permission Mail.Read). Leave empty to disable.
GRAPH_MAILBOX=info@line-net.ge
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=

# Set to 0 on serverless hosts. Call the cron API from an external scheduler.
INTERNAL_CRON=1

# Shared secret for POST /api/inbound-email and /api/cron/poll-mail
INBOUND_EMAIL_SECRET=change-me

# Attachments directory (local disk or a mounted volume)
UPLOAD_DIR=./uploads

# Seed password for demo users (npm run db:seed)
SEED_PASSWORD=linenet123

# Email notifications (SMTP). Leave empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Line Net CRM <crm@line-net.ge>"
